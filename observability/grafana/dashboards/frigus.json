{
  "title": "Frigus.AI",
  "uid": "frigus-ai-overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 101,
      "title": "p95 / limite do SLO",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "frigus:turn_latency_p95_seconds:5m / scalar(frigus_slo_target{sli=\"latency_p95_seconds\"})",
          "legendFormat": "p95 / limite do SLO"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "description": "p95 do turno (5m) dividido pelo limite do SLO. Acima de 100% = SLO estourado."
    },
    {
      "id": 102,
      "title": "Erro / limite do SLO",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "targets": [
        {
          "expr": "frigus:turn_error_ratio:5m / scalar(frigus_slo_target{sli=\"error_ratio\"})",
          "legendFormat": "Erro / limite do SLO"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "description": "Taxa de erro (5m) dividida pelo limite. Bloqueio do guardrail não conta como erro."
    },
    {
      "id": 103,
      "title": "Orçamento de erro (30d)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "1 - frigus:turn_error_ratio:30d / scalar(frigus_slo_target{sli=\"error_ratio\"})",
          "legendFormat": "Orçamento de erro (30d)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "description": "Quanto do espaço de falha dos últimos 30 dias ainda resta. Negativo = SLO violado no período."
    },
    {
      "id": 104,
