    {
      "id": 109,
      "title": "p95 do turno vs SLO",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "frigus:turn_latency_p95_seconds:5m",
          "legendFormat": "p95"
        },
        {
          "expr": "frigus_slo_target{sli=\"latency_p95_seconds\"}",
          "legendFormat": "limite do SLO"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 110,
      "title": "Custo acumulado por modelo (USD)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (model) (frigus_llm_cost_usd_total)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "title": "Requests HTTP por rota (req/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (route, status_class) (rate(frigus_http_requests_total[5m]))",
          "legendFormat": "{{route}} [{{status_class}}]"
        }
      ]
    },
    {
      "id": 2,
      "title": "Duração HTTP p95 por rota",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(frigus_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
