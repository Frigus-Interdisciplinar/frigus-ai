# API Keys
GEMINI_API_KEY=<your_api_key>
GROQ_API_KEY=<your_api_key>
ANTHROPIC_API_KEY=<your_api_key>

# Postgres (schema `dataload` — ver data/sql/schema.sql)
POSTGRES_URI=postgresql://frigus:frigus@localhost:5432/frigus

# Mongo (histórico do chatbot + perfil comportamental + checkpoints do LangGraph)
MONGODB_URI=mongodb://localhost:27017

# Observabilidade dos agentes (opcional) — deixar LANGSMITH_TRACING=false para desligar
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<your_api_key>
LANGSMITH_PROJECT=frigus-ai

# Spoonacular (receitas/ingredientes — ver .agents/skills/spoonacular.md). Opcional até a tool
# existir (tools/spoonacular/, em andamento — ver TODO.md); tier gratuito é 50 pontos/dia.
SPOONACULAR_API_KEY=<your_api_key>

# Redis (cache do perfil comportamental + rate limit de mensagens — tools/redis/)
REDIS_URL=redis://localhost:6379/0

# Qdrant (RAG do FAQ, substitui o FAISS local — tools/qdrant/faq/). QDRANT_API_KEY só é
# necessário pra instância cloud; vazio funciona com o Qdrant local do docker-compose.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=faq
