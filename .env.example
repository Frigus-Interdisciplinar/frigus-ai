# Os grupos do settings viram prefixo com "__" (API__, DATABASE__, API_KEYS__, LLM__, OBSERVABILITY__).
# API Keys
LLM__GEMINI__API_KEY=<your_api_key>
LLM__GROQ__API_KEY=<your_api_key>
LLM__CLAUDE__API_KEY=<your_api_key>
LLM__OPENROUTER__API_KEY=<your_api_key>
# Vercel AI Gateway: GPT-6 Luna como fallback pago nas cadeias e JeV (guardrail de entrada, roteador
# e juiz). Exige cartão cadastrado na conta Vercel, até pros créditos gratuitos. Vazio = fora.
LLM__GATEWAY__API_KEY=

# Postgres (Supabase, schema `public` — tabelas com UUID e enums em inglês)
DATABASE__POSTGRES_URI=postgresql://frigus:frigus@localhost:5432/frigus

# Mongo (histórico do chatbot, fatos do usuário e checkpoints do LangGraph)
DATABASE__MONGODB_URI=mongodb://localhost:27017

# Neo4j (grafo de receitas — infra/neo4j/). Credenciais batem com NEO4J_AUTH do docker-compose.yml
DATABASE__NEO4J_URI=bolt://neo4j:frigus123@localhost:7687

# Observabilidade dos agentes (opcional) — deixar LANGSMITH_TRACING=false para desligar
OBSERVABILITY__LANGSMITH_TRACING=false
OBSERVABILITY__LANGSMITH_API_KEY=<your_api_key>
OBSERVABILITY__LANGSMITH_PROJECT=frigus-ai

# Spoonacular (receitas/ingredientes — ver .agents/skills/spoonacular.md). Opcional; o tier
# gratuito é 50 pontos/dia.
API_KEYS__SPOONACULAR_API_KEY=<your_api_key>

# Firebase (infra/firebase/): valida o Bearer do login do app Frigus. Basta o ID do projeto
# (project_info.project_id do google-services.json); a service account é opcional.
API_KEYS__FIREBASE_PROJECT_ID=
API_KEYS__FIREBASE_CREDENTIALS_PATH=

# Redis (rate limit, cache do guardrail, ranking de desperdício e API keys — infra/redis/)
DATABASE__REDIS_URL=redis://localhost:6379/0

# Qdrant (RAG do FAQ e resumos de chats — graph/tools/faq/). QDRANT_API_KEY só é
# necessário pra instância cloud; vazio funciona com o Qdrant local do docker-compose.
DATABASE__QDRANT_URL=http://localhost:6333
DATABASE__QDRANT_API_KEY=
DATABASE__QDRANT_COLLECTION_NAME=faq
DATABASE__QDRANT_CHATS_COLLECTION=chats

# local | production. Em production, API_KEY_AUTH_ENABLED=false aborta o boot.
ENVIRONMENT=local
# Auth da API. Desligado por padrão pra TUI/demo continuarem rodando sem key;
# ligue junto com SIGNUP_SECRET pra exigir X-API-Key nas rotas de chat.
API__KEY_AUTH_ENABLED=false
# Origens do CORS (lista JSON). "*" só em local.
API__CORS_ORIGINS=["*"]
API_KEYS__SIGNUP_SECRET=
# Hot reload do uvicorn (dev). Desligue fora da máquina local.
API__RELOAD=true
# Vazio: /metrics aberto (dev). Preenchido: exige "Authorization: Bearer <token>". O `just obs`
# repassa o valor ao Prometheus (observability/prometheus/metrics_token, fora do git).
API_KEYS__METRICS_TOKEN=

# A2A (Agent2Agent — ver api/routes/a2a.py)
API__A2A_BASE_URL=http://localhost:8000
# Assessor (finanças pessoais) como agente remoto — URL base dele (o cliente chama `/a2a`)
# e a X-API-Key que o Frigus usa lá. Vazio: o Frigus responde que o Assessor está indisponível.
API__ASSESSOR_A2A_URL=http://localhost:8001
API_KEYS__ASSESSOR_API_KEY=

# Prometheus (métricas — evals/sre_report.py). Porta do docker-compose.yml.
OBSERVABILITY__PROMETHEUS_URL=http://localhost:9090
# Timeout (s, POR TENTATIVA) e retries EXTRAS de cada provider — provider caído (503, cota) não segura o
# turno e o with_fallbacks assume. Pior caso de um provider caído = (retries + 1) * timeout.
# LLM__GEMINI__TIMEOUT_S=30
# LLM__GEMINI__RETRIES=0
# LLM__GROQ__TIMEOUT_S=30
# LLM__GROQ__RETRIES=1
# LLM__CLAUDE__TIMEOUT_S=60
# LLM__CLAUDE__RETRIES=1
# LLM__OPENROUTER__TIMEOUT_S=30
# LLM__OPENROUTER__RETRIES=0
# LLM__GATEWAY__TIMEOUT_S=45
# LLM__GATEWAY__RETRIES=1
# LLM__GATEWAY__BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
# Teto menor pra saída curta e estruturada (guardrail, juiz, roteador, fatos/resumo) e pra visão.
# LLM__TIMEOUT_CURTO_S=15
# LLM__TIMEOUT_VISAO_S=60
# Limites do grafo (defaults abaixo).
# LLM__MAX_HISTORICO_MENSAGENS=21
# LLM__MAX_REESCRITAS_JUIZ=2
# LLM__DEFAULT_TEMPERATURE=0.7
# LLM__GUARDRAIL_TEMPERATURE=0.0
# LLM__VISION_TEMPERATURE=0.1
# LLM__EMBEDDING_MODEL=gemini-embedding-001
# Segredo do HMAC das API keys no Redis. Vazio = SHA-256 puro. Mudar invalida todas as keys emitidas.
# API_KEYS__HASH_SECRET=
